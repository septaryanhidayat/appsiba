<IfModule dir_module>
    DirectoryIndex index.php public/index.php
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
  AddHandler application/x-httpd-ea-php84___lsphp .php
</IfModule>
# php -- END cPanel-generated handler

# Prevent Direct Access to Sensitive Files
<FilesMatch "(^\.|\.(env|log|yml|yaml|json|lock|sql|sh|dist|example|md|git|bak|ini)$)">
    Order allow,deny
    Deny from all
</FilesMatch>

<Files artisan>
    Order allow,deny
    Deny from all
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to core Laravel directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L,NC]

    # Serve existing public files directly
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Rewrite empty root to public/index.php
    RewriteRule ^$ public/index.php [L]

    # Send all other requests to public/index.php
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>
